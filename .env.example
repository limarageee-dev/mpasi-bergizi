# ==========================================
# KONFIGURASI NOTION HEADLESS CMS (MPASI BERGIZI)
# ==========================================

# 1. Notion API Token (Secret dari Internal Integration)
# Buat di https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_notion_api_token_here

# 2. Database ID dari Notion Database MPASI Bergizi
# Salin 32 karakter dari URL database Notion Anda
NOTION_DATABASE_ID=your_notion_database_id_here

# URL Website (opsional untuk local, default production di Vercel)
PUBLIC_SITE_URL=https://mpasi-bergizi.vercel.app
