---
// src/components/Hero.astro
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden bg-gradient-to-b from-brand-50/70 via-warmbg to-warmbg">
  
  <!-- Colorful Decorative Elements -->
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 pointer-events-none overflow-hidden">
    <div class="absolute -top-10 -right-10 w-80 h-80 bg-peach-400/20 rounded-full blur-3xl"></div>
    <div class="absolute top-20 -left-10 w-96 h-96 bg-brand-400/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-72 h-72 bg-honey-400/20 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Content Column -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Trust Pill Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white shadow-sm border border-brand-200/60 text-xs font-bold text-brand-700">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-peach-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-peach-500"></span>
          </span>
          <span>Solusi No. 1 Menu Praktis untuk Ibu Rumah Tangga</span>
        </div>

        <!-- Single Primary H1 for Homepage SEO -->
        <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl tracking-tight text-gray-900 leading-[1.15]">
          Solusi <span class="text-gradient-brand">MPASI Bergizi</span> & Menu Praktis Harian Si Kecil
        </h1>

        <!-- Engaging Subtitle -->
        <p class="text-lg sm:text-xl text-gray-600 leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Gak perlu pusing lagi mikirin menu tiap pagi! Hadirkan nutrisi 4 bintang lengkap tinggi zat besi, cegah GTM, dan buat si kecil makan lahap hanya dalam 15 menit.
        </p>

        <!-- CTA Utama Button (Direct from Prompt) -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="#cta-section"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-brand-600 text-white font-extrabold text-sm sm:text-base tracking-wide uppercase shadow-xl shadow-brand-600/35 hover:bg-brand-700 hover:shadow-brand-600/50 hover:-translate-y-1 active:translate-y-0 transition-all duration-200 text-center"
            id="hero-primary-cta"
          >
            <span>KLIK LINK DIBIO DAN PILIH MENU FAVORIT SIKECIL</span>
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="/blog"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-full bg-white hover:bg-brand-50 border-2 border-brand-200 text-brand-700 font-bold text-sm transition-all duration-200 shadow-sm"
          >
            <span>Lihat Resep Gratis</span>
            <span class="text-xs bg-peach-100 text-peach-600 px-2 py-0.5 rounded-full font-extrabold">20+ Menu</span>
          </a>
        </div>

        <!-- Social Proof Key Stats -->
        <div class="pt-6 border-t border-brand-100/80 grid grid-cols-3 gap-4 text-center lg:text-left max-w-md mx-auto lg:mx-0">
          <div>
            <div class="font-display font-extrabold text-2xl sm:text-3xl text-brand-700">10k+</div>
            <div class="text-xs font-semibold text-gray-500 mt-0.5">Ibu Terbantu</div>
          </div>
          <div>
            <div class="font-display font-extrabold text-2xl sm:text-3xl text-peach-500">100%</div>
            <div class="text-xs font-semibold text-gray-500 mt-0.5">Bahan Alami</div>
          </div>
          <div>
            <div class="font-display font-extrabold text-2xl sm:text-3xl text-emerald-600">0 GTM</div>
            <div class="text-xs font-semibold text-gray-500 mt-0.5">Anak Lahap</div>
          </div>
        </div>

      </div>

      <!-- Right Visual Column (Modern Colorful Card Composition) -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Main Food Highlight Card -->
          <div class="relative rounded-3xl overflow-hidden shadow-2xl bg-white border-4 border-white">
            <img
              src="https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=900&q=80"
              alt="MPASI Bergizi - Solusi Menu Praktis Ibu Rumah Tangga"
              width="600"
              height="500"
              class="w-full h-80 sm:h-96 object-cover hover:scale-105 transition-transform duration-500"
              loading="eager"
            />
            
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
            
            <div class="absolute bottom-4 left-4 right-4 p-4 rounded-2xl bg-white/95 backdrop-blur-md border border-white/40 shadow-lg">
              <div class="flex items-center justify-between">
                <div>
                  <span class="inline-block text-[11px] font-bold text-peach-600 bg-peach-50 px-2.5 py-0.5 rounded-full mb-1">
                    Menu Terpopuler Minggu Ini
                  </span>
                  <p class="font-display font-bold text-gray-900 text-sm sm:text-base">
                    Puree Daging Sapi & Labu Kuning Lembut
                  </p>
                </div>
                <span class="text-2xl">🥣</span>
              </div>
            </div>
          </div>

          <!-- Floating Badge 1: Nutrisi 4 Bintang -->
          <div class="absolute -top-6 -left-6 bg-white p-3.5 rounded-2xl shadow-xl border border-brand-100 flex items-center gap-3 animate-bounce-subtle">
            <div class="w-10 h-10 rounded-xl bg-peach-100 text-peach-600 flex items-center justify-center font-bold text-lg">
              ⭐
            </div>
            <div>
              <div class="text-xs font-bold text-gray-800">Nutrisi 4 Bintang</div>
              <div class="text-[11px] text-gray-500">Standar Resmi IDAI</div>
            </div>
          </div>

          <!-- Floating Badge 2: Praktis 15 Menit -->
          <div class="absolute -bottom-6 -right-6 bg-white p-3.5 rounded-2xl shadow-xl border border-brand-100 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold text-lg">
              ⏱️
            </div>
            <div>
              <div class="text-xs font-bold text-gray-800">Masak 15 Menit</div>
              <div class="text-[11px] text-gray-500">Praktis Tanpa Repot</div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
