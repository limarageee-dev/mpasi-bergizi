---
// src/components/Footer.astro
const categories = [
  'MPASI 6 Bulan',
  'Resep Anti GTM',
  'Booster Berat Badan',
  'Meal Prep Mingguan',
  'Finger Food Sehat',
  'Jadwal & Tekstur',
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#210924] text-white border-t border-brand-800/50 pt-16 pb-12 mt-20 relative overflow-hidden">
  <!-- Subtle colorful ambient glow -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-brand-600/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-peach-500/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand Bio -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-brand-500 to-peach-400 flex items-center justify-center text-white font-bold shadow-lg shadow-brand-500/30">
            MB
          </div>
          <span class="font-display font-extrabold text-2xl tracking-tight text-white">
            MPASI <span class="text-peach-400">BERGIZI</span>
          </span>
        </div>
        <p class="text-gray-300 text-sm leading-relaxed">
          Sahabat terpercaya ibu rumah tangga dalam menghadirkan menu MPASI praktis, bergizi seimbang, dan bebas ribet untuk mendukung tumbuh kembang optimal si kecil tanpa stunting.
        </p>
        <div class="pt-2">
          <span class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded-full bg-brand-900/80 border border-brand-500/40 text-peach-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            100% Panduan Nutrisi Sesuai IDAI
          </span>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-4">
        <h3 class="font-display font-bold text-lg text-white">Navigasi Utama</h3>
        <ul class="space-y-2.5 text-sm text-gray-300">
          <li>
            <a href="/" class="hover:text-peach-400 transition-colors inline-flex items-center gap-2">
              <span class="text-brand-400">›</span> Beranda Utama
            </a>
          </li>
          <li>
            <a href="/blog" class="hover:text-peach-400 transition-colors inline-flex items-center gap-2">
              <span class="text-brand-400">›</span> Kumpulan Resep & Menu Praktis
            </a>
          </li>
          <li>
            <a href="/about" class="hover:text-peach-400 transition-colors inline-flex items-center gap-2">
              <span class="text-brand-400">›</span> Tentang MPASI Bergizi
            </a>
          </li>
          <li>
            <a href="#cta-section" class="hover:text-peach-400 transition-colors inline-flex items-center gap-2">
              <span class="text-brand-400">›</span> Katalog Paket Menu Favorit
            </a>
          </li>
        </ul>
      </div>

      <!-- Categories / Topics -->
      <div class="space-y-4">
        <h3 class="font-display font-bold text-lg text-white">Topik Menu Praktis</h3>
        <div class="flex flex-wrap gap-2">
          {categories.map((category) => (
            <a
              href={`/blog?tag=${encodeURIComponent(category)}`}
              class="text-xs px-3 py-1.5 rounded-lg bg-white/5 hover:bg-brand-600/50 hover:text-white border border-white/10 text-gray-300 transition-all duration-200"
            >
              {category}
            </a>
          ))}
        </div>
      </div>

      <!-- Contact & Link di Bio -->
      <div class="space-y-4">
        <h3 class="font-display font-bold text-lg text-white">Link di Bio & Pesanan</h3>
        <p class="text-gray-300 text-sm">
          Pesan langsung paket bahan menu harian siap masak atau konsultasi panduan MPASI:
        </p>
        <div class="space-y-2.5 pt-1">
          <a
            href="https://wa.me/?text=Halo%20Bunda,%20saya%20mau%20pesan%20menu%20MPASI%20Bergizi%20favorit%20si%20kecil"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs transition-colors"
          >
            <span>💬 Chat WhatsApp Admin</span>
          </a>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 border border-white/15 text-white font-semibold text-xs transition-colors"
          >
            <span>📸 Instagram @mpasibergizi.id</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-400 gap-4">
      <p>
        © {currentYear} <strong>MPASI BERGIZI</strong>. Hak Cipta Dilindungi Undang-Undang. Menu Praktis untuk Ibu Rumah Tangga.
      </p>
      <div class="flex items-center gap-6">
        <a href="/robots.txt" class="hover:text-white transition-colors">Robots.txt</a>
        <a href="/sitemap-index.xml" class="hover:text-white transition-colors">Sitemap XML</a>
      </div>
    </div>
  </div>
</footer>
