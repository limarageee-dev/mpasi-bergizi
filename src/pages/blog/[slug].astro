---
// src/pages/blog/[slug].astro
import Layout from '../../layouts/Layout.astro';
import NotionBlocks from '../../components/NotionBlocks.astro';
import BlogCard from '../../components/BlogCard.astro';
import {
  getAllPosts,
  getPostBlocks,
  getRelatedPosts,
  type BlogPost,
} from '../../lib/notion';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

export interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Fetch Notion blocks content for this post
const blocks = await getPostBlocks(post.id);

// Fetch 3 related posts based on tags (SEO Internal Linking requirement)
const relatedPosts = await getRelatedPosts(post.slug, post.tags, 3);

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://mpasi-bergizi.vercel.app';
const articleUrl = `${siteUrl}/blog/${post.slug}`;
const pageTitle = `${post.title} | MPASI BERGIZI`;
const coverAlt = `${post.title} - MPASI BERGIZI`;

// Article Schema.org JSON-LD
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt.slice(0, 160),
  image: [post.cover],
  datePublished: post.date,
  dateModified: post.date,
  author: {
    '@type': 'Person',
    name: post.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'MPASI BERGIZI',
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  articleSection: post.tags[0] || 'Menu Praktis',
  keywords: post.tags.join(', '),
};
---

<Layout
  title={pageTitle}
  description={post.excerpt.slice(0, 160)}
  image={post.cover}
  canonical={articleUrl}
  type="article"
  author={post.author}
  publishedTime={post.date}
  modifiedTime={post.date}
  tags={post.tags}
  schema={articleSchema}
>
  <article class="py-12 bg-warmbg min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center flex-wrap gap-2 text-xs font-semibold text-gray-500">
          <li>
            <a href="/" class="hover:text-brand-600 transition-colors">Beranda</a>
          </li>
          <li class="text-gray-400">/</li>
          <li>
            <a href="/blog" class="hover:text-brand-600 transition-colors">Blog Resep & Menu</a>
          </li>
          <li class="text-gray-400">/</li>
          <li class="text-brand-600 font-bold truncate max-w-[200px] sm:max-w-xs" aria-current="page">
            {post.title}
          </li>
        </ol>
      </nav>

      <!-- Post Header Info -->
      <header class="mb-10 space-y-5">
        
        <!-- Category Badges -->
        <div class="flex flex-wrap gap-2">
          {post.tags.map((tag) => (
            <a
              href={`/blog?tag=${encodeURIComponent(tag)}`}
              class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold bg-brand-100 text-brand-800 hover:bg-brand-600 hover:text-white transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>

        <!-- Article Title (H1) -->
        <h1 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-gray-900 leading-tight">
          {post.title}
        </h1>

        <!-- Excerpt Intro Box -->
        <p class="text-lg sm:text-xl text-gray-600 leading-relaxed font-normal bg-brand-50/50 p-5 rounded-2xl border border-brand-100/70">
          {post.excerpt}
        </p>

        <!-- Meta Details: Author, Date, Reading Time -->
        <div class="flex flex-wrap items-center justify-between gap-4 py-4 border-y border-brand-100 text-xs sm:text-sm text-gray-600">
          
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-brand-600 text-white font-bold flex items-center justify-center text-sm shadow-sm">
              {post.author.slice(0, 1)}
            </div>
            <div>
              <div class="font-bold text-gray-900">{post.author}</div>
              <div class="text-[11px] text-gray-500">Konsultan Resep MPASI Bergizi</div>
            </div>
          </div>

          <div class="flex items-center gap-6">
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span>{post.formattedDate}</span>
            </div>

            <div class="flex items-center gap-1.5 text-peach-600 font-bold">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span>{post.readingTime}</span>
            </div>
          </div>

        </div>

      </header>

      <!-- Featured Image with Mandatory SEO Alt Text -->
      <figure class="mb-12 rounded-3xl overflow-hidden shadow-card border-4 border-white bg-brand-50">
        <img
          src={post.cover}
          alt={coverAlt}
          width="1200"
          height="675"
          loading="eager"
          class="w-full h-[360px] sm:h-[480px] object-cover"
        />
        <figcaption class="p-3 text-center text-xs text-gray-500 bg-white">
          {coverAlt} • Koleksi MPASI Bergizi
        </figcaption>
      </figure>

      <!-- Notion Content Blocks Body -->
      <div class="bg-white rounded-3xl p-6 sm:p-10 lg:p-12 border border-brand-100 shadow-soft mb-16">
        <NotionBlocks blocks={blocks} />
      </div>

      <!-- In-Article CTA Box for Ibu Rumah Tangga -->
      <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-tr from-brand-700 via-brand-600 to-peach-500 text-white shadow-xl text-center mb-20 relative overflow-hidden">
        <div class="relative z-10 space-y-4">
          <span class="inline-block px-3.5 py-1 rounded-full bg-white/20 text-xs font-bold tracking-wider uppercase text-honey-200">
            Solusi Praktis Bunda
          </span>
          <h2 class="font-display font-extrabold text-2xl sm:text-3xl">
            Suka Menu Ini? Pesan Bahan Praktis Siap Olahnya Sekarang!
          </h2>
          <p class="text-brand-100 text-sm sm:text-base max-w-xl mx-auto">
            Gak usah repot belanja ke pasar dan nimbang gramasi protein. Paket bahan segar MPASI BERGIZI sudah terukur higienis untuk 3 hari masak.
          </p>
          <div class="pt-3">
            <a
              href="https://wa.me/?text=Halo%20Admin%20MPASI%20Bergizi,%20saya%20tertarik%20dengan%20menu%20dan%20mau%20order%20paket%20MPASI"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-peach-500 hover:bg-peach-600 text-white font-extrabold text-sm uppercase tracking-wide shadow-lg hover:scale-105 transition-transform"
            >
              <span>KLIK LINK DIBIO DAN PILIH MENU FAVORIT SIKECIL</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Related Posts Section (Internal Linking Requirement) -->
      {relatedPosts.length > 0 && (
        <section class="pt-8 border-t border-brand-100">
          <div class="flex items-center justify-between mb-8">
            <div>
              <span class="text-xs font-bold text-peach-600 uppercase tracking-widest">Rekomendasi Bunda</span>
              <h2 class="font-display font-extrabold text-2xl sm:text-3xl text-gray-900">
                Artikel & Menu Terkait
              </h2>
            </div>
            <a
              href="/blog"
              class="text-xs font-bold text-brand-600 hover:text-peach-600 transition-colors hidden sm:inline-flex items-center gap-1"
            >
              <span>Lihat Semua</span>
              <span>&rarr;</span>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedPosts.map((related) => (
              <BlogCard post={related} />
            ))}
          </div>
        </section>
      )}

    </div>
  </article>
</Layout>
