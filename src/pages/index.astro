---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import { getLatestPosts } from '../lib/notion';

// Ambil 3 postingan terbaru dari Notion API
const latestPosts = await getLatestPosts(3);

const metaDescription =
  'Resep MPASI bergizi dan kumpulan menu praktis untuk ibu rumah tangga. Panduan nutrisi 4 bintang cegah GTM agar tumbuh kembang si kecil optimal dan lahap!';
---

<Layout
  title="MPASI BERGIZI - Solusi Menu Praktis & Nutrisi Si Kecil untuk Ibu Rumah Tangga"
  description={metaDescription}
>
  <!-- Hero Section -->
  <Hero />

  <!-- Why Choose Us / Fitur Unggulan (3 Poin Utama) -->
  <section class="py-20 bg-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block text-xs font-extrabold uppercase tracking-widest text-brand-600 bg-brand-50 px-4 py-1.5 rounded-full mb-3">
          Kenapa Memilih MPASI Bergizi?
        </span>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-gray-900 tracking-tight">
          3 Alasan Mengapa <span class="text-brand-600">Ribuan Bunda</span> Mempercayai Menu Kami
        </h2>
        <p class="mt-4 text-base sm:text-lg text-gray-600 leading-relaxed">
          Kami memahami kerepotan ibu rumah tangga yang ingin selalu memberikan nutrisi terbaik tanpa harus menghabiskan berjam-jam di dapur.
        </p>
      </div>

      <!-- 3 Key Features Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
        
        <!-- Poin 1 -->
        <div class="p-8 rounded-3xl bg-warmbg border border-brand-100 hover:border-brand-300 transition-all duration-300 hover:shadow-card hover:-translate-y-1 relative group">
          <div class="w-16 h-16 rounded-2xl bg-peach-100 text-peach-600 flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform shadow-sm">
            🥣
          </div>
          <h3 class="font-display font-bold text-xl text-gray-900 mb-3 group-hover:text-brand-600 transition-colors">
            1. Formulasi 4 Bintang Sesuai IDAI
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Setiap porsi dirancang presisi dengan karbohidrat kompleks, protein hewani tinggi zat besi, protein nabati, dan lemak tambahan untuk mengoptimalkan berat badan & fungsi otak.
          </p>
          <div class="mt-4 flex items-center gap-2 text-xs font-bold text-peach-600">
            <span>Bebas Anemia & Stunting</span>
            <span>&check;</span>
          </div>
        </div>

        <!-- Poin 2 -->
        <div class="p-8 rounded-3xl bg-warmbg border border-brand-100 hover:border-brand-300 transition-all duration-300 hover:shadow-card hover:-translate-y-1 relative group">
          <div class="w-16 h-16 rounded-2xl bg-brand-100 text-brand-700 flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform shadow-sm">
            ⚡
          </div>
          <h3 class="font-display font-bold text-xl text-gray-900 mb-3 group-hover:text-brand-600 transition-colors">
            2. Menu Praktis Siap Olah 15 Menit
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Didesain khusus untuk ibu rumah tangga sibuk. Panduan tahapan meal prep ringkas membuat proses memasak menu segar harian jadi super cepat dan menyenangkan.
          </p>
          <div class="mt-4 flex items-center gap-2 text-xs font-bold text-brand-700">
            <span>Hemat Waktu & Energi</span>
            <span>&check;</span>
          </div>
        </div>

        <!-- Poin 3 -->
        <div class="p-8 rounded-3xl bg-warmbg border border-brand-100 hover:border-brand-300 transition-all duration-300 hover:shadow-card hover:-translate-y-1 relative group">
          <div class="w-16 h-16 rounded-2xl bg-honey-100 text-honey-600 flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform shadow-sm">
            😋
          </div>
          <h3 class="font-display font-bold text-xl text-gray-900 mb-3 group-hover:text-brand-600 transition-colors">
            3. Rasa Gurih Alami Anti GTM
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Kombinasi kaldu tulang murni dan rempah aromatik alami tanpa gula garam berlebih. Tekstur disesuaikan usia bayi sehingga si kecil makan lahap tanpa drama tutup mulut!
          </p>
          <div class="mt-4 flex items-center gap-2 text-xs font-bold text-honey-600">
            <span>Piring Bersih Seketika</span>
            <span>&check;</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Section Blog Terbaru (Mengambil 3 post terbaru dari Notion) -->
  <section class="py-20 bg-warmbg relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="inline-block text-xs font-extrabold uppercase tracking-widest text-brand-600 bg-brand-50 px-4 py-1.5 rounded-full mb-3">
            Inspirasi Dapur Bunda
          </span>
          <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-gray-900 tracking-tight">
            Menu Praktis & Resep <span class="text-brand-600">Terbaru</span>
          </h2>
          <p class="mt-2 text-gray-600 text-sm sm:text-base">
            Tips, panduan tekstur, dan kreasi resep MPASI bergizi terupdate langsung dari Notion CMS.
          </p>
        </div>

        <div class="mt-4 md:mt-0">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 text-sm font-bold text-brand-600 hover:text-peach-600 transition-colors"
          >
            <span>Jelajahi Semua Resep</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Blog Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {latestPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>

    </div>
  </section>

  <!-- CTA Section Utama -->
  <section id="cta-section" class="py-20 bg-gradient-to-br from-brand-700 via-brand-600 to-[#9E3AA7] text-white relative overflow-hidden">
    <!-- Glow effects -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-peach-500/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-honey-400/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/15 backdrop-blur-md text-xs font-bold uppercase tracking-wider text-honey-200 mb-6">
        <span>🎉 Promo Eksklusif Ibu Rumah Tangga</span>
      </div>

      <h2 class="font-display font-extrabold text-3xl sm:text-5xl tracking-tight leading-tight mb-6">
        Yuk Bunda, Bikin Momen Makan Si Kecil Jadi Paling Ditunggu!
      </h2>

      <p class="text-base sm:text-xl text-brand-100 max-w-2xl mx-auto leading-relaxed mb-10">
        Dapatkan paket menu MPASI bergizi siap masak, kaldu aromatik bebas pengawet, dan panduan menu lengkap 30 hari anti bingung.
      </p>

      <!-- Main Action CTA Link -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://wa.me/?text=Halo%20Bunda,%20saya%20mau%20order%20menu%20favorit%20MPASI%20Bergizi%20untuk%20si%20kecil"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-5 rounded-full bg-peach-500 hover:bg-peach-600 text-white font-black text-sm sm:text-base tracking-wide uppercase shadow-2xl shadow-black/25 hover:scale-105 active:scale-100 transition-all duration-200"
          id="main-bottom-cta"
        >
          <span>KLIK LINK DIBIO DAN PILIH MENU FAVORIT SIKECIL</span>
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <p class="mt-4 text-xs text-brand-200 font-medium">
        ⚡ Respon Cepat Admin WhatsApp • Konsultasi Menu Gratis • Pengiriman Seluruh Indonesia
      </p>

    </div>
  </section>
</Layout>
