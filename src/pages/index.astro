---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import { getLatestPosts } from '../lib/notion';

// Ambil 3 postingan terbaru dari Notion API
const latestPosts = await getLatestPosts(3);

const metaDescription =
  'Resep MPASI bergizi dan kumpulan menu praktis untuk ibu rumah tangga. Panduan nutrisi 4 bintang cegah GTM agar tumbuh kembang si kecil optimal dan lahap!';
---

<Layout
  title="MPASI BERGIZI - Solusi Menu Praktis & Nutrisi Si Kecil untuk Ibu Rumah Tangga"
  description={metaDescription}
>
  <!-- Hero Section -->
  <Hero />

  <!-- Why Choose Us / Fitur Unggulan (3 Poin Utama) -->
  <section class="py-20 bg-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block text-xs font-extrabold uppercase tracking-widest text-brand-600 bg-brand-50 px-4 py-1.5 rounded-full mb-3">
          Kenapa Memilih MPASI Bergizi?
        </span>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-gray-900 tracking-tight">
          3 Alasan Mengapa <span class="text-brand-600">Ribuan Bunda</span> Mempercayai Menu Kami
        </h2>
        <p class="mt-4 text-base sm:text-lg text-gray-600 leading-relaxed">
          Kami memahami kerepotan ibu rumah tangga yang ingin selalu memberikan nutrisi terbaik tanpa harus menghabiskan berjam-jam di dapur.
        </p>
      </div>

      <!-- 3 Key Features Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
        
        <!-- Poin 1 -->
        <div class="p-8 rounded-3xl bg-warmbg border border-brand-100 hover:border-brand-300 transition-all duration-300 hover:shadow-card hover:-translate-y-1 relative group">
          <div class="w-16 h-16 rounded-2xl bg-peach-100 text-peach-600 flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform shadow-sm">
            🥣
          </div>
          <h3 class="font-display font-bold text-xl text-gray-900 mb-3 group-hover:text-brand-600 transition-colors">
            1. Formulasi 4 Bintang Sesuai IDAI
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Setiap porsi dirancang presisi dengan karbohidrat kompleks, protein hewani tinggi zat besi, protein nabati, dan lemak tambahan untuk mengoptimalkan berat badan & fungsi otak.
          </p>
          <div class="mt-4 flex items-center gap-2 text-xs font-bold text-peach-600">
            <span>Bebas Anemia & Stunting</span>
            <span>&check;</span>
          </div>
        </div>

        <!-- Poin 2 -->
        <div class="p-8 rounded-3xl bg-warmbg border border-brand-100 hover:border-brand-300 transition-all duration-300 hover:shadow-card hover:-translate-y-1 relative group">
          <div class="w-16 h-16 rounded-2xl bg-brand-100 text-brand-700 flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform shadow-sm">
            ⚡
          </div>
          <h3 class="font-display font-bold text-xl text-gray-900 mb-3 group-hover:text-brand-600 transition-colors">
            2. Menu Praktis Siap Olah 15 Menit
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Didesain khusus untuk ibu rumah tangga sibuk. Panduan tahapan meal prep ringkas membuat proses memasak menu segar harian jadi super cepat dan menyenangkan.
          </p>
          <div class="mt-4 flex items-center gap-2 text-xs font-bold text-brand-700">
            <span>Hemat Waktu & Energi</span>
            <span>&check;</span>
          </div>
        </div>

        <!-- Poin 3 -->
        <div class="p-8 rounded-3xl bg-warmbg border border-brand-100 hover:border-brand-300 transition-all duration-300 hover:shadow-card hover:-translate-y-1 relative group">
          <div class="w-16 h-16 rounded-2xl bg-honey-100 text-honey-600 flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform shadow-sm">
            😋
          </div>
          <h3 class="font-display font-bold text-xl text-gray-900 mb-3 group-hover:text-brand-600 transition-colors">
            3. Rasa Gurih Alami Anti GTM
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Kombinasi kaldu tulang murni dan rempah aromatik alami tanpa gula garam berlebih. Tekstur disesuaikan usia bayi sehingga si kecil makan lahap tanpa drama tutup mulut!
          </p>
          <div class="mt-4 flex items-center gap-2 text-xs font-bold text-honey-600">
            <span>Piring Bersih Seketika</span>
            <span>&check;</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Showcase Produk Unggulan: Kremesan Double Prohe (Sesuai Gambar 2) -->
  <section id="produk-section" class="py-16 md:py-24 bg-gradient-to-b from-white via-orange-50/60 to-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-orange-500 via-orange-600 to-amber-500 rounded-3xl p-8 sm:p-12 lg:p-16 text-white shadow-2xl relative overflow-hidden">
        
        <!-- Ambient decorative glow -->
        <div class="absolute -top-24 -right-24 w-80 h-80 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center relative z-10">
          
          <!-- Text column -->
          <div class="lg:col-span-6 space-y-6 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/20 backdrop-blur-md text-xs font-bold uppercase tracking-wider text-white border border-white/20">
              <span>⭐ Kremes Otak Sapi No. 1 di Indonesia</span>
            </div>
            
            <h2 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl tracking-tight leading-tight">
              Kremesan Double Prohe <br />
              <span class="text-amber-200">Otak Sapi Grass-Fed</span>
            </h2>

            <p class="text-orange-50 text-base sm:text-lg leading-relaxed">
              Sensasi gurih renyah alami kaya zat besi tinggi, protein hewani ganda, dan asam folat. Solusi paling ampuh mengatasi anak GTM (Gerakan Tutup Mulut) serta membantu kenaikan berat badan si kecil secara sehat dan optimal!
            </p>

            <div class="grid grid-cols-2 gap-4 pt-2 text-left">
              <div class="bg-white/15 backdrop-blur-sm p-4 rounded-2xl border border-white/20">
                <div class="text-2xl mb-1">🥩</div>
                <div class="font-bold text-sm text-white">Double Prohe Alami</div>
                <div class="text-xs text-orange-100 mt-0.5">Daging & Otak Sapi Pilihan</div>
              </div>
              <div class="bg-white/15 backdrop-blur-sm p-4 rounded-2xl border border-white/20">
                <div class="text-2xl mb-1">😋</div>
                <div class="font-bold text-sm text-white">Renyah Lumer di Mulut</div>
                <div class="text-xs text-orange-100 mt-0.5">Bikin Anak Lahap Makan</div>
              </div>
            </div>

            <div class="pt-2 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a
                href="https://wa.me/?text=Halo%20Bunda,%20saya%20mau%20order%20Kremesan%20Double%20Prohe%20Otak%20Sapi%20untuk%20si%20kecil"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-white text-orange-600 font-black text-sm sm:text-base tracking-wide uppercase shadow-xl hover:bg-orange-50 hover:scale-105 active:scale-100 transition-all duration-200"
              >
                <span>Pesan Kremesan Sekarang</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Product Image column (Directly using Gambar 2: Kremesan Double Prohe) -->
          <div class="lg:col-span-6 relative">
            <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-white group">
              <img
                src="/images/kremesan-double-prohe.jpg"
                alt="Kremesan Double Prohe Otak Sapi MPASI Bergizi No 1 di Indonesia"
                width="600"
                height="450"
                class="w-full h-80 sm:h-[420px] object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="lazy"
              />
              <div class="absolute bottom-3 left-3 right-3 p-3.5 rounded-2xl bg-white/95 backdrop-blur-md text-gray-800 text-xs font-semibold flex items-center justify-between shadow-lg border border-orange-100">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span class="font-bold text-gray-900 text-sm">Kemasan Jar 125gr Higienis</span>
                </div>
                <span class="text-orange-600 font-extrabold text-sm">Siap Tabur 🥣</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Section Blog Terbaru (Mengambil 3 post terbaru dari Notion) -->
  <section class="py-20 bg-warmbg relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="inline-block text-xs font-extrabold uppercase tracking-widest text-orange-600 bg-orange-50 px-4 py-1.5 rounded-full mb-3 border border-orange-200">
            Inspirasi Dapur Bunda
          </span>
          <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-gray-900 tracking-tight">
            Menu Praktis & Resep <span class="text-orange-500">Terbaru</span>
          </h2>
          <p class="mt-2 text-gray-600 text-sm sm:text-base">
            Tips, panduan tekstur, dan kreasi resep MPASI bergizi terupdate langsung dari Notion CMS.
          </p>
        </div>

        <div class="mt-4 md:mt-0">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 text-sm font-bold text-orange-600 hover:text-orange-700 transition-colors"
          >
            <span>Jelajahi Semua Resep</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Blog Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {latestPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>

    </div>
  </section>

  <!-- CTA Section Utama (Modern Orange & Pure White) -->
  <section id="cta-section" class="py-20 bg-gradient-to-br from-orange-600 via-orange-500 to-amber-500 text-white relative overflow-hidden">
    <!-- Glow effects -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-amber-300/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/20 backdrop-blur-md text-xs font-bold uppercase tracking-wider text-white mb-6 border border-white/20">
        <span>🎉 Promo Eksklusif Ibu Rumah Tangga</span>
      </div>

      <h2 class="font-display font-extrabold text-3xl sm:text-5xl tracking-tight leading-tight mb-6">
        Yuk Bunda, Bikin Momen Makan Si Kecil Jadi Paling Ditunggu!
      </h2>

      <p class="text-base sm:text-xl text-orange-100 max-w-2xl mx-auto leading-relaxed mb-10">
        Dapatkan Kremesan Double Prohe Otak Sapi siap tabur, kaldu tulang aromatik, dan panduan menu lengkap 30 hari anti GTM.
      </p>

      <!-- Main Action CTA Link -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://wa.me/?text=Halo%20Bunda,%20saya%20mau%20order%20menu%20favorit%20MPASI%20Bergizi%20untuk%20si%20kecil"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-5 rounded-full bg-white hover:bg-orange-50 text-orange-600 font-black text-sm sm:text-base tracking-wide uppercase shadow-2xl shadow-black/20 hover:scale-105 active:scale-100 transition-all duration-200"
          id="main-bottom-cta"
        >
          <span>KLIK LINK DIBIO DAN PILIH MENU FAVORIT SIKECIL</span>
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <p class="mt-4 text-xs text-orange-100 font-medium">
        ⚡ Respon Cepat Admin WhatsApp • Konsultasi Menu Gratis • Pengiriman Seluruh Indonesia
      </p>

    </div>
  </section>
</Layout>
