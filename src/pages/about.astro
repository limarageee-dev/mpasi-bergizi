---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';

const team = [
  {
    name: 'dr. Sarah Sp.A',
    role: 'Konsultan Spesialis Anak & Tumbuh Kembang',
    bio: 'Fokus pada riset oromotor bayi dan pencegahan dini stunting melalui intervensi MPASI kaya zat besi.',
    avatar: 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=400&q=80',
  },
  {
    name: 'Rina Oktavia, S.Gz',
    role: 'Ahli Gizi Klinis Ibu & Anak',
    bio: 'Menyusun kalkulasi mikro dan makronutrien harian agar pas dengan kebutuhan lambung bayi.',
    avatar: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=400&q=80',
  },
  {
    name: 'Chef Maya Pratiwi',
    role: 'Kuliner & Meal Prep Specialist',
    bio: 'Ibu rumah tangga & chef yang menciptakan teknik memasak MPASI 15 menit dengan rasa gurih alami anti GTM.',
    avatar: 'https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?auto=format&fit=crop&w=400&q=80',
  },
];
---

<Layout
  title="Tentang Kami | MPASI BERGIZI - Sahabat Setia Dapur Ibu Rumah Tangga"
  description="Pelajari kisah MPASI BERGIZI, komitmen nutrisi 4 bintang IDAI, standar higienis bahan organik, dan tim ahli pendamping tumbuh kembang si kecil."
>
  <!-- Page Header -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-brand-50 to-warmbg border-b border-brand-100/60">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <span class="inline-block text-xs font-extrabold uppercase tracking-widest text-brand-600 bg-white border border-brand-200 px-4 py-1.5 rounded-full mb-4 shadow-sm">
        Kenali Visi & Dedikasi Kami
      </span>
      <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-gray-900 tracking-tight">
        Mendampingi Setiap Langkah <span class="text-brand-600">Ibu Rumah Tangga</span> Menuju Generasi Sehat
      </h1>
      <p class="mt-6 text-base sm:text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto">
        MPASI BERGIZI lahir dari empati terhadap perjuangan jutaan ibu yang sering merasa cemas, lelah, dan bingung saat si kecil mulai masuk masa MPASI.
      </p>
    </div>
  </section>

  <!-- Story & Mission Section -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <div class="space-y-6">
          <span class="text-xs font-bold text-peach-600 uppercase tracking-widest">Kisah Awal</span>
          <h2 class="font-display font-bold text-2xl sm:text-3xl text-gray-900">
            Berawal dari Dapur Sederhana, Menjadi Gerakan Nasional Anti GTM
          </h2>
          <p class="text-gray-600 leading-relaxed text-sm sm:text-base">
            Banyak ibu rumah tangga merasa bersalah saat anak mogok makan (GTM) atau berat badannya seret. Faktanya, memasak MPASI bergizi tidak harus rumit, memakan waktu 2 jam, atau menggunakan bahan mahal.
          </p>
          <p class="text-gray-600 leading-relaxed text-sm sm:text-base">
            Dengan prinsip kearifan pangan lokal Indonesia—seperti hati ayam kampung, ikan lele segar, tempe murni, dan labu kuning manis—kami menghadirkan menu yang ramah kantong, gampang dipraktekkan, dan terbukti disukai bayi.
          </p>
          <div class="grid grid-cols-2 gap-4 pt-4">
            <div class="p-4 rounded-2xl bg-brand-50 border border-brand-100">
              <div class="font-display font-bold text-2xl text-brand-700">100%</div>
              <div class="text-xs text-gray-600 mt-1">Bahan Pilihan Segar</div>
            </div>
            <div class="p-4 rounded-2xl bg-peach-50 border border-peach-100">
              <div class="font-display font-bold text-2xl text-peach-600">Tanpa MSG</div>
              <div class="text-xs text-gray-600 mt-1">& Pengawet Kimia</div>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="rounded-3xl overflow-hidden shadow-xl border-4 border-white">
            <img
              src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=800&q=80"
              alt="Dapur MPASI Bergizi dan Persiapan Menu Segar"
              loading="lazy"
              class="w-full h-[420px] object-cover"
            />
          </div>
          <div class="absolute -bottom-6 -left-6 bg-white p-5 rounded-2xl shadow-xl border border-brand-100 max-w-xs">
            <div class="text-xs font-bold text-brand-600 uppercase">Standar Mutu</div>
            <p class="text-xs text-gray-700 mt-1 font-medium">
              Dipandu protokol kebersihan tinggi, pengemasan kedap udara, dan panduan higienitas dapur rumah tangga.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Team of Experts -->
  <section class="py-20 bg-warmbg border-t border-brand-100/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-extrabold uppercase tracking-widest text-brand-600 bg-brand-50 px-4 py-1.5 rounded-full mb-3 inline-block">
          Tim Ahli Kami
        </span>
        <h2 class="font-display font-extrabold text-3xl text-gray-900">
          Didampingi Para Profesional Kesehatan Anak
        </h2>
        <p class="mt-3 text-sm sm:text-base text-gray-600">
          Semua resep dan rekomendasi kami divalidasi oleh dokter spesialis anak dan ahli gizi klinis terakreditasi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {team.map((member) => (
          <div class="bg-white rounded-3xl p-6 border border-brand-100 shadow-soft text-center group hover:shadow-card transition-all duration-300">
            <div class="w-24 h-24 mx-auto rounded-full overflow-hidden mb-5 border-4 border-brand-100 group-hover:border-brand-500 transition-colors">
              <img
                src={member.avatar}
                alt={member.name}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>
            <h3 class="font-display font-bold text-lg text-gray-900 mb-1">{member.name}</h3>
            <p class="text-xs font-bold text-peach-600 mb-3">{member.role}</p>
            <p class="text-xs text-gray-600 leading-relaxed">{member.bio}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA Box -->
  <section class="py-16 bg-brand-600 text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-display font-extrabold text-2xl sm:text-4xl mb-4">
        Ingin Konsultasi Menu Spesifik untuk Bayi Bunda?
      </h2>
      <p class="text-brand-100 text-sm sm:text-base mb-8 max-w-xl mx-auto">
        Ketahui menu yang paling cocok berdasarkan usia, riwayat alergi, dan preferensi rasa si kecil.
      </p>
      <a
        href="https://wa.me/?text=Halo%20MPASI%20Bergizi,%20saya%20ingin%20konsultasi%20menu%20dan%20pesan%20menu%20favorit%20si%20kecil"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-peach-500 hover:bg-peach-600 text-white font-extrabold text-sm uppercase tracking-wide shadow-lg transition-transform hover:-translate-y-0.5"
      >
        <span>KLIK LINK DIBIO DAN PILIH MENU FAVORIT SIKECIL</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </section>
</Layout>
